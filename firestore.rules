rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validRoomId(roomId) { return roomId.matches('r[0-9a-f]{64}'); }
    match /rooms/{roomId} {
      allow list, update, delete: if false;
      allow get: if signedIn() && validRoomId(roomId);
      allow create: if signedIn() && validRoomId(roomId)
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt == request.time;
      match /messages/{messageId} {
        allow get, list: if signedIn() && validRoomId(roomId);
        allow create: if signedIn() && validRoomId(roomId)
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && request.resource.data.keys().hasOnly(['senderId','iv','cipher','createdAt'])
          && request.resource.data.keys().hasAll(['senderId','iv','cipher','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.iv is string
          && request.resource.data.iv.matches('[0-9a-f]{24}')
          && request.resource.data.cipher is string
          && request.resource.data.cipher.size() >= 32
          && request.resource.data.cipher.size() <= 10000
          && request.resource.data.cipher.matches('[0-9a-f]+')
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
